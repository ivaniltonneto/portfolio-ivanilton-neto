---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { person, contact } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${person.name} — back-end, arquitetura de software e IA`,
  description = 'Portfólio de Ivanilton Neto, Tech Lead em back-end, arquitetura de software e IA aplicada: trajetória, estudos de caso, método de documentação e competências com evidência.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: person.fullName,
  jobTitle: 'Tech Lead',
  description: person.role,
  email: `mailto:${contact.email}`,
  telephone: '+55-88-92176-9346',
  url: canonical.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Juazeiro do Norte', addressRegion: 'CE', addressCountry: 'BR' },
  sameAs: [contact.github.href, contact.linkedin.href],
  knowsAbout: ['Back-end', 'Arquitetura de software', 'Inteligência artificial', 'RAG', 'Sistemas multiagente', 'Python', 'FastAPI', 'Node.js'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'UNINASSAU — Centro Universitário Maurício de Nassau' },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ivanilton Neto: três camadas empilhadas — back-end, arquitetura e IA aplicada." />
    <meta property="profile:first_name" content="Ivanilton" />
    <meta property="profile:last_name" content="Neto" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
