---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — Ivanilton Neto" description="Este endereço não existe neste portfólio." noindex>
  <main id="conteudo" class="page nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">Este endereço não existe aqui.</h1>
    <p class="nf__text">O portfólio tem uma única página. Pode ser um link antigo ou digitado com erro.</p>
    <p><a class="nf__link" href="/">Ir para o portfólio</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: var(--space-s);
    padding-block: var(--space-xl);
  }
  .nf__code {
    font-size: var(--step-5);
    font-stretch: var(--wide);
    font-weight: 820;
    line-height: var(--leading-tight);
    color: var(--layer-arq);
  }
  .nf__title {
    font-size: var(--step-3);
    font-stretch: var(--semi-wide);
    line-height: 1.05;
    max-width: 18ch;
  }
  .nf__text {
    max-width: 48ch;
    color: var(--ink-soft);
  }
  .nf__link {
    font-weight: 700;
  }
</style>
