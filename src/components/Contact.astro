---
import Icon from './Icon.astro';
import { contact, person } from '../data/profile';
const [user, domain] = contact.email.split('@');
---

<footer class="contact" id="contato" aria-labelledby="contato-t">
  <div class="contact__grid">
    <h2 id="contato-t" class="contact__title">Contato</h2>
    <p class="contact__lead">
      Para conversar sobre back-end, arquitetura ou IA aplicada, o caminho mais direto é o e-mail.
    </p>
  </div>

  <a class="contact__email" href={`mailto:${contact.email}`}>
    <span>{user}</span><wbr /><span>@{domain}</span>
  </a>

  <ul class="contact__links" role="list" aria-label="Outros contatos">
    <li><a href={contact.whatsapp.href} aria-label={`WhatsApp ${contact.whatsapp.label}`} title={`WhatsApp ${contact.whatsapp.label}`} rel="noopener"><Icon name="whatsapp" /></a></li>
    <li><a href={contact.linkedin.href} aria-label="LinkedIn" title="LinkedIn" rel="me noopener"><Icon name="linkedin" /></a></li>
    <li><a href={contact.github.href} aria-label="GitHub" title="GitHub" rel="me noopener"><Icon name="github" /></a></li>
  </ul>

  <div class="colophon">
    <p>Revisão de <time datetime={person.revisionISO}>{person.revision}</time>.</p>
  </div>
</footer>

<style>
  .contact {
    border-top: 2px solid var(--rule-strong);
    padding-block: var(--space-xl) var(--space-l);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-s);
  }
  .contact__title {
    grid-column: 1 / span 4;
    font-size: var(--step-3);
    font-stretch: var(--semi-wide);
    font-weight: 760;
    line-height: 1.02;
  }
  .contact__lead {
    grid-column: 5 / -1;
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .contact__email {
    display: block;
    margin-top: var(--space-xl);
    font-size: clamp(1.6rem, 0.3rem + 5.6vw, 6.25rem);
    font-stretch: var(--wide);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-decoration: none;
    overflow-wrap: anywhere;
    padding-bottom: 0.12em;
    border-bottom: 6px solid var(--ink);
  }
  .contact__email span:last-child {
    font-weight: 300;
    font-stretch: var(--narrow);
  }
  .contact__email:hover {
    color: var(--layer-ia);
    border-bottom-color: var(--layer-ia);
  }
  .contact__links {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
    margin-inline-start: -0.6rem;
  }
  .contact__links a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-size: 1.75rem;
    color: var(--ink);
    transition: color 160ms var(--ease);
  }
  .contact__links a:hover {
    color: var(--layer-ia);
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    margin-top: var(--space-2xl);
    padding-top: var(--space-s);
    border-top: var(--rule-w) solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-soft);
    justify-content: center;
    text-align: center;
  }
  @media (max-width: 59.99rem) {
    .contact__title,
    .contact__lead {
      grid-column: 1 / -1;
    }
  }
</style>
