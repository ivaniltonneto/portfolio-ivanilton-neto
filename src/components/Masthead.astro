---
import { Image } from 'astro:assets';
import StackDiagram from './StackDiagram.astro';
import Icon from './Icon.astro';
import photo from '../assets/ivanilton-neto.jpg';
import { person, contact, languages } from '../data/profile';
---

<section class="masthead" id="topo" aria-labelledby="nome">
  <h1 id="nome" class="masthead__name">
    <span>Ivanilton</span>
    <span>Neto</span>
  </h1>

  <div class="masthead__grid">
    <div class="masthead__text">
      <p class="masthead__role">{person.role}</p>
      <p class="masthead__lede">{person.lede}</p>

      <ul class="masthead__links" role="list" aria-label="Contato">
        <li><a href={`mailto:${contact.email}`} aria-label="E-mail" title={contact.email}><Icon name="email" /></a></li>
        <li><a href={contact.whatsapp.href} aria-label="WhatsApp" title={`WhatsApp ${contact.whatsapp.label}`} rel="noopener"><Icon name="whatsapp" /></a></li>
        <li><a href={contact.linkedin.href} aria-label="LinkedIn" title="LinkedIn" rel="me noopener"><Icon name="linkedin" /></a></li>
        <li><a href={contact.github.href} aria-label="GitHub" title="GitHub" rel="me noopener"><Icon name="github" /></a></li>
      </ul>

      <div class="titleblock">
        <figure class="titleblock__photo">
          <Image src={photo} alt={person.photoAlt} widths={[160, 320]} sizes="(min-width: 40rem) 9.5rem, 7rem" loading="eager" />
        </figure>
        <dl class="titleblock__meta">
          <div>
            <dt>Mora em</dt>
            <dd>{person.location}</dd>
          </div>
          <div>
            <dt>Idiomas</dt>
            <dd>{languages.map((l) => `${l.name} ${l.level.toLowerCase()}`).join(', ')}</dd>
          </div>
          <div>
            <dt>Revisão</dt>
            <dd><time datetime={person.revisionISO}>{person.revision}</time></dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="masthead__figure">
      <StackDiagram />
    </div>
  </div>
</section>

<style>
  .masthead {
    padding-block: var(--space-l) var(--space-xl);
  }
  .masthead__name {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    font-size: var(--step-5);
    font-stretch: var(--wide);
    font-weight: 820;
    line-height: var(--leading-tight);
    letter-spacing: -0.035em;
    margin-inline-start: -0.04em;
  }
  .masthead__name span:last-child {
    font-weight: 300;
    font-stretch: var(--narrow);
    letter-spacing: -0.02em;
  }
  .masthead__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-l);
    margin-top: var(--space-l);
    align-items: start;
  }
  .masthead__text {
    grid-column: 1 / span 5;
    padding-top: var(--space-m);
    border-top: 2px solid var(--rule-strong);
  }
  .masthead__figure {
    grid-column: 6 / -1;
    position: relative;
  }
  .masthead__role {
    font-size: var(--step-2);
    font-stretch: var(--semi-wide);
    font-weight: 650;
    line-height: 1.15;
    max-width: 22ch;
  }
  .masthead__lede {
    margin-top: var(--space-m);
    max-width: 46ch;
    color: var(--ink);
  }
  .masthead__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
    margin-inline-start: -0.6rem;
  }
  .masthead__links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.5rem;
    color: var(--ink);
    transition: color 160ms var(--ease);
  }
  .masthead__links a:hover {
    color: var(--layer-ia);
  }
  /* Carimbo: o bloco de identificação de um desenho técnico */
  .titleblock {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    margin-top: var(--space-l);
    border: 1.5px solid var(--rule-strong);
    font-size: var(--step--1);
  }
  .titleblock__photo {
    margin: 0;
    border-inline-end: 1.5px solid var(--rule-strong);
    background: var(--paper-sunk);
    position: relative;
    min-height: 11.5rem;
    overflow: hidden;
  }
  .titleblock__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .titleblock__meta {
    display: grid;
    align-content: stretch;
  }
  .titleblock__meta div {
    display: grid;
    align-content: center;
    gap: 0.1rem;
    padding: var(--space-2xs) var(--space-s);
  }
  .titleblock__meta div + div {
    border-top: var(--rule-w) solid var(--rule-strong);
  }
  .titleblock__meta dt {
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }
  .titleblock__meta dd {
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .titleblock {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }
  @media (max-width: 59.99rem) {
    .masthead__text,
    .masthead__figure {
      grid-column: 1 / -1;
    }
    .masthead__figure {
      order: -1;
    }
  }
</style>
