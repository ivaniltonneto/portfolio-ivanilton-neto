---
import CaseMap from './CaseMap.astro';
import { cases, layers } from '../data/profile';

const layerName = Object.fromEntries(layers.map((l) => [l.id, l.name]));
---

<section class="section" id="casos" aria-labelledby="casos-t">
  <header class="section__head">
    <h2 id="casos-t" class="section__title">Estudos de caso</h2>
    <p class="section__standfirst">
      Problemas reais em que trabalhei, do contexto à decisão. O que é sigiloso do cliente fica de fora.
    </p>
    <nav class="cases__index" aria-label="Casos">
      <ol role="list">
        {cases.map((c) => (
          <li class={`l-${c.layer}`} data-layers={c.layers.join(' ')}>
            <a href={`#caso-${c.id}`}>
              <span class="slab-mark" aria-hidden="true"></span>
              <span>{c.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </header>

  <div class="section__body cases">
    {cases.map((c) => (
      <article class={`case l-${c.layer}`} id={`caso-${c.id}`} data-layers={c.layers.join(' ')} aria-labelledby={`caso-${c.id}-t`}>
        <header class="case__head">
          <p class="case__layer">
            <span class="slab-mark" aria-hidden="true"></span>
            {layerName[c.layer]}
          </p>
          <h3 class="case__title" id={`caso-${c.id}-t`}>{c.title}</h3>
          <p class="case__ref">
            <span>{c.roleRef}</span>
            <span>{c.period}</span>
          </p>
          <p class="case__scope">{c.scope}</p>
        </header>

        <dl class="case__fields">
          {c.fields.map((f) => (
            <div class={`case__field ${f.body === null ? 'is-empty' : ''}`}>
              <dt>{f.label}</dt>
              <dd>
                {f.body === null ? (
                  <p>{f.empty ?? 'Sem indicadores públicos. O currículo não registra resultados numéricos, e nenhum foi estimado aqui.'}</p>
                ) : Array.isArray(f.body) ? (
                  <ul>{f.body.map((b) => <li>{b}</li>)}</ul>
                ) : (
                  <p>{f.body}</p>
                )}
              </dd>
            </div>
          ))}
        </dl>

        {c.map && <CaseMap map={c.map} id={`map-${c.id}`} />}
      </article>
    ))}
  </div>
</section>

<style>
  .cases__index {
    margin-top: var(--space-l);
    font-size: var(--step--1);
  }
  .cases__index ol {
    border-top: var(--rule-w) solid var(--rule);
  }
  .cases__index li {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .cases__index a {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    padding-block: var(--space-2xs);
    text-decoration: none;
  }
  .cases__index a:hover span:last-child {
    text-decoration: underline;
  }
  @media (max-width: 59.99rem) {
    .cases__index {
      display: none;
    }
  }

  .cases {
    display: grid;
    gap: var(--space-2xl);
  }
  .case__layer {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--c);
    font-weight: 650;
    font-size: var(--step--1);
  }
  .case__title {
    margin-top: var(--space-xs);
    font-size: var(--step-3);
    font-stretch: var(--semi-wide);
    font-weight: 740;
    line-height: 1.05;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }
  .case__ref {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    margin-top: var(--space-s);
    font-weight: 600;
  }
  .case__ref span + span {
    color: var(--ink-soft);
    font-weight: 400;
  }
  .case__scope {
    margin-top: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    background: var(--paper-sunk);
    border-inline-start: 3px solid var(--c);
    font-size: var(--step--1);
    max-width: 62ch;
  }

  .case__fields {
    margin-top: var(--space-l);
    border-top: 2px solid var(--c);
  }
  .case__field {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-m);
    padding-block: var(--space-s);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .case__field dt {
    font-weight: 700;
    font-stretch: var(--semi-wide);
  }
  .case__field dd {
    max-width: var(--measure);
  }
  .case__field ul {
    padding-inline-start: 1.1em;
  }
  .case__field li::marker {
    content: '–';
    color: var(--c);
  }
  .case__field li {
    padding-inline-start: 0.25em;
  }
  .case__field li + li {
    margin-top: 0.25em;
  }
  .case__field.is-empty dd {
    color: var(--ink-soft);
    font-size: var(--step--1);
    padding-inline-start: var(--space-s);
    background: repeating-linear-gradient(-45deg, transparent 0 7px, color-mix(in srgb, var(--ink) 7%, transparent) 7px 8px);
    border-inline-start: 1px dashed var(--ink-soft);
    padding-block: var(--space-2xs);
  }

  @media (max-width: 40rem) {
    .case__field {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
